---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const format = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

{
  posts.length === 0 ? (
    <p class="text-sm text-muted">Nothing published yet.</p>
  ) : (
    <ul class="divide-y divide-border">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-6">
            <time datetime={post.data.date.toISOString()} class="shrink-0 font-mono text-xs text-muted sm:w-24">
              {format(post.data.date)}
            </time>
            <span class="group-hover:text-accent">{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
