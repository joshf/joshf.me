---
interface Props {
  title: string;
  id?: string;
  more?: { href: string; label: string };
}

const { title, id, more } = Astro.props;
---

<section id={id} class="mt-16 scroll-mt-8">
  <div class="mb-6 flex items-baseline justify-between">
    <h2 class="font-mono text-sm text-muted">
      <span class="text-accent">##</span> {title}
    </h2>
    {more && <a href={more.href} class="font-mono text-xs text-muted hover:text-accent">{more.label} →</a>}
  </div>
  <slot />
</section>
